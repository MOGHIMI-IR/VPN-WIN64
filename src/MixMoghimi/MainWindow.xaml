<Window x:Class="MixMoghimi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIX-MOGHIMI" Width="1280" Height="820" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="False" FlowDirection="RightToLeft"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <LinearGradientBrush x:Key="AuraGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D9161C3A" Offset="0" />
            <GradientStop Color="#CC0B1426" Offset="0.5" />
            <GradientStop Color="#D111102B" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A58BFF" Offset="0" />
            <GradientStop Color="#7165FF" Offset="0.55" />
            <GradientStop Color="#39C5FF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ConnectGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8E72FF" Offset="0" />
            <GradientStop Color="#5E5CF4" Offset="0.52" />
            <GradientStop Color="#27B8E9" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8894B2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F7F8FF" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ActionCardButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="13,11" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootGlass" CornerRadius="28" Background="{StaticResource AuraGradient}" BorderBrush="#42FFFFFF" BorderThickness="1" ClipToBounds="True" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="IntroOffset" Y="16" />
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="RootGlass" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.65" />
                        <DoubleAnimation Storyboard.TargetName="IntroOffset" Storyboard.TargetProperty="Y" From="16" To="0" Duration="0:0:0.65" DecelerationRatio="0.82" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#C810152B" Offset="0" />
                    <GradientStop Color="#C80B1322" Offset="0.58" />
                    <GradientStop Color="#D0101126" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <!-- Ambient glass / aurora lighting -->
            <Ellipse Width="520" Height="520" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-260,0,0" IsHitTestVisible="False">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#6A5AFF" Offset="0"/><GradientStop Color="#326A5AFF" Offset="0.35"/><GradientStop Color="#006A5AFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="90" /></Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="450" Height="450" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-220,-230" IsHitTestVisible="False">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#183DCBFF" Offset="0"/><GradientStop Color="#103DCBFF" Offset="0.4"/><GradientStop Color="#003DCBFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="82" /></Ellipse.Effect>
            </Ellipse>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- Top title bar -->
                <Grid Grid.Row="0" Background="#1AFFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="M" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MIX" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="MOGHIMI NETWORK" FontSize="8" Foreground="#8E9AB8" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft">
                        <Ellipse x:Name="TopStatusDot" Width="7" Height="7" Fill="#43D6A0" Margin="0,0,8,0" />
                        <TextBlock x:Name="TopStatusText" Text="در حال آماده‌سازی" FontSize="11" Foreground="#AFB9D3" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="VersionText" Text="BETA  •  0.1.0" Foreground="#7C88A7" FontSize="10" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Button Width="34" Height="34" Content="—" Click="Minimize_Click" Background="Transparent" Foreground="#B9C2D9" BorderThickness="0" FontSize="16" Cursor="Hand" />
                        <Button Width="34" Height="34" Content="×" Click="Close_Click" Background="Transparent" Foreground="#B9C2D9" BorderThickness="0" FontSize="22" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="238" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Sidebar -->
                    <Border Grid.Column="0" Background="#13FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0" Padding="18,28,18,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="6,0,6,0">
                                <TextBlock Text="فضای اتصال تو" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="یک اتصال ساده، سریع و امن" FontSize="11" Foreground="#8590AE" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Background="#332A3C72" Foreground="White" Click="DashboardNav_Click" Margin="0,0,0,7">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="18" Margin="0,0,12,0" Foreground="#A998FF"/><TextBlock Text="داشبورد" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavButton}" Click="ServersNav_Click" Margin="0,0,0,7">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontSize="18" Margin="0,0,12,0" Foreground="#64CFFF"/><TextBlock Text="سرورها" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button Style="{StaticResource NavButton}" Click="SupportNav_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="✧" FontSize="18" Margin="0,0,12,0" Foreground="#FFD18A"/><TextBlock Text="حمایت و پشتیبانی" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <Border Grid.Row="4" CornerRadius="18" Padding="15" Background="#1DFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MIX ACCESS" Foreground="#9F91FF" FontSize="9" />
                                    <TextBlock Text="۳ ساعت در هفته" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,3" />
                                    <TextBlock Text="بدون حساب کاربری و اشتراک" FontSize="10" Foreground="#8B96B2" TextWrapping="Wrap" />
                                    <Border Height="1" Background="#26FFFFFF" Margin="0,13,0,11" />
                                    <TextBlock Text="Designed for focus." FontSize="10" Foreground="#8490AE" FlowDirection="LeftToRight" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Main stage -->
                    <Grid Grid.Column="1" Margin="30,25,30,24">
                        <Grid x:Name="DashboardView">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="پنل کنترل اتصال" FontSize="25" FontWeight="Bold" />
                                    <TextBlock x:Name="GreetingText" Text="همه‌چیز برای یک اتصال روان آماده است." Foreground="#8F9AB7" FontSize="12" Margin="0,7,0,0" />
                                </StackPanel>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="20" Padding="13,8" Background="#20FFFFFF" BorderBrush="#2CFFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#43D6A0" Margin="0,0,7,0" />
                                        <TextBlock Text="بدون پروفایل و اشتراک" FontSize="10" Foreground="#B8C2DA" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="0.85*" />
                                </Grid.ColumnDefinitions>
                                <!-- Connection hero -->
                                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,15,0" Padding="26">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="CONNECTION CORE" FontSize="10" Foreground="#9D91FF" FlowDirection="LeftToRight" />
                                            <TextBlock x:Name="ConnectionStatusText" Text="آمادهٔ اتصال" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Row="1" MinHeight="250">
                                            <Ellipse Width="248" Height="248" Stroke="#255C7CFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Width="202" Height="202" Stroke="#2A9D8CFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Width="160" Height="160" Stroke="#20FFFFFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse Width="150" Height="150" Fill="#3A786EFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Effect><BlurEffect Radius="38" /></Ellipse.Effect>
                                            </Ellipse>
                                            <Ellipse Width="188" Height="188" Stroke="#5B8B84FF" StrokeThickness="1.5" Opacity="0.28" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="PulseScale" CenterX="94" CenterY="94" ScaleX="0.82" ScaleY="0.82" />
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1.08" Duration="0:0:1.25" />
                                                                <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1.08" Duration="0:0:1.25" />
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.10" To="0.46" Duration="0:0:1.25" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <Button x:Name="ConnectButton" Width="132" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center" Click="ConnectButton_Click" Cursor="Hand" BorderThickness="0" Background="{StaticResource ConnectGradient}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid>
                                                            <Ellipse x:Name="Ring" Fill="#2AFFFFFF" Stroke="#80FFFFFF" StrokeThickness="1" />
                                                            <Ellipse Margin="9" Fill="#1BFFFFFF" />
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock x:Name="Glyph" Text="⏻" FontSize="36" HorizontalAlignment="Center" Foreground="White" />
                                                                <TextBlock x:Name="ActionLabel" Text="اتصال" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" Margin="0,3,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="Stroke" Value="#FFFFFFFF" />
                                                                <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Ring" Property="Opacity" Value="0.55" /></Trigger>
                                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Ring" Property="Opacity" Value="0.55" /></Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="SelectedServerText" Text="سروری انتخاب نشده" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="ConnectionHintText" Text="برای شروع، یک سرور انتخاب کن." FontSize="10" Foreground="#8793B0" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                                <Border Background="#20FFFFFF" CornerRadius="12" Padding="11,7" Margin="4,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◉" Foreground="#45D6A2" Margin="0,0,7,0"/><TextBlock x:Name="SessionDurationText" Text="۰۰:۰۰:۰۰" FontSize="11" Foreground="#C7D0E5" FlowDirection="LeftToRight" /></StackPanel>
                                                </Border>
                                                <Border Background="#20FFFFFF" CornerRadius="12" Padding="11,7" Margin="4,0">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="↯" Foreground="#7BCFFF" Margin="0,0,7,0"/><TextBlock Text="Proxy Engine" FontSize="11" Foreground="#C7D0E5" FlowDirection="LeftToRight" /></StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Stats / server summary -->
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1.05*" />
                                        <RowDefinition Height="0.95*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="سهمیهٔ هفتگی" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="۷ روز شناور" FontSize="10" Foreground="#8894B2" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="TrialRemainingText" Text="۳:۰۰:۰۰" FontSize="31" FontWeight="Bold" Margin="0,18,0,2" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="TrialUsedText" Text="مصرف‌شده: ۰۰:۰۰:۰۰ از ۰۳:۰۰:۰۰" FontSize="10" Foreground="#8995B1" />
                                            <ProgressBar x:Name="TrialProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,17,0,0" Background="#24304C" BorderThickness="0" Foreground="#8D7AFF" />
                                            <TextBlock x:Name="ResetDateText" Text="شارژ بعدی: پس از اولین استفاده" FontSize="10" Foreground="#8D99B5" Margin="0,12,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="آمار اینترنت" FontSize="15" FontWeight="SemiBold" />
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="↓ دریافت" Foreground="#73D7FF" FontSize="11" />
                                                    <TextBlock x:Name="DownloadValue" Text="۰ B" Style="{StaticResource MetricValue}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="↑ ارسال" Foreground="#B7A1FF" FontSize="11" />
                                                    <TextBlock x:Name="UploadValue" Text="۰ B" Style="{StaticResource MetricValue}" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Height="1" Background="#24FFFFFF" Margin="0,17,0,12" />
                                            <TextBlock x:Name="TrafficPeriodText" Text="مصرف این هفته" FontSize="10" Foreground="#8995B1" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="◈" Foreground="#9A8CFF" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="اتصال با هستهٔ sing-box" FontSize="10" Foreground="#8792AD" />
                                </StackPanel>
                                <TextBlock Text="MIX • MADE FOR A BETTER CONNECTION" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontSize="9" Foreground="#697694" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Server catalogue -->
                        <Grid x:Name="ServersView" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="انتخاب سرور" FontSize="25" FontWeight="Bold" />
                                <TextBlock Text="فقط سرورهای فعال پنل ویندوز نمایش داده می‌شوند." FontSize="12" Foreground="#8F9AB7" Margin="0,7,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="22">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,15">
                                        <TextBlock Text="لیست سرورها" FontSize="15" FontWeight="SemiBold" />
                                        <Button Content="↻ بروزرسانی" Style="{StaticResource ActionCardButton}" HorizontalAlignment="Left" Click="RefreshServers_Click" />
                                    </Grid>
                                    <ListBox x:Name="ServersList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="ServersList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,10" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" CornerRadius="15" Background="#1AFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="15"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#393F6D"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#8C79FF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#70FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="38" Height="38" CornerRadius="12" Background="#2B7B74DD"><TextBlock Text="✦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#DDD7FF" /></Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Shadowsocks • Encrypted" FontSize="10" Foreground="#8995B1" Margin="0,3,0,0" FlowDirection="LeftToRight"/></StackPanel>
                                                    <TextBlock Grid.Column="2" Text="انتخاب" FontSize="10" Foreground="#A99BFF" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Grid.Row="1" x:Name="EmptyServersPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="◇" FontSize="38" Foreground="#9383FF" HorizontalAlignment="Center" />
                                        <TextBlock Text="هنوز سروری اضافه نشده" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                        <TextBlock Text="کانفیگ‌های ویندوز باید از پنل سرور ثبت شوند." FontSize="11" Foreground="#8995B1" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" x:Name="ServerSelectionHint" Text="برای اتصال، یک سرور را انتخاب کن." FontSize="10" Foreground="#8A96B3" Margin="0,14,0,0" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Support page -->
                        <Grid x:Name="SupportView" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                                <Border Width="92" Height="92" CornerRadius="28" Background="#2A8F7AFF" HorizontalAlignment="Center">
                                    <TextBlock Text="✧" FontSize="46" Foreground="#FFE0A4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="پشت MIX باش" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                                <TextBlock Text="با حمایتت به بهتر شدن کیفیت سرویس و توسعهٔ نسخه‌های بعدی کمک می‌کنی." FontSize="12" Foreground="#929DB8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Border Style="{StaticResource GlassCard}" Margin="0,25,0,0" Padding="22" Width="430">
                                    <StackPanel>
                                        <TextBlock Text="ارتباط با پشتیبانی" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="برای حمایت یا گزارش مشکل، از مسیر رسمی تلگرام استفاده کن." FontSize="10" Foreground="#8793B0" TextAlignment="Center" Margin="0,8,0,17" />
                                        <Button Content="✦   ورود به پشتیبانی تلگرام" Style="{StaticResource SecondaryButton}" Click="SupportTelegram_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
